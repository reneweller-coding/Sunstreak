# Embeds every file under DATA_DIR into OUT as byte arrays, so the game stays one file while its data (places,
# countries, the route, landmark shapes) lives in readable text files.
#
#   cmake -DDATA_DIR=<dir> -DOUT=<file.cpp> -P Embed.cmake
file( GLOB_RECURSE files RELATIVE "${DATA_DIR}" "${DATA_DIR}/*.txt" )
list( SORT files )
set( body "// Generated by cmake/Embed.cmake from data/; do not edit.\n#include \"Data.h\"\n\nnamespace sunstreak\n{\n\nnamespace\n{\n\n" )
set( table "" )
set( index 0 )
foreach( f ${files} )
    file( READ "${DATA_DIR}/${f}" hex HEX )
    string( LENGTH "${hex}" chars )
    math( EXPR bytes "${chars} / 2" )
    string( REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}" )
    # Lines of 32 bytes keep the generated file readable for the compiler.
    string( REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" hex "${hex}" )
    string( APPEND body "const unsigned char File${index}[] = {\n${hex}\n0x00 };\n\n" )
    string( APPEND table "        { \"${f}\", File${index}, ${bytes} },\n" )
    math( EXPR index "${index} + 1" )
endforeach()
string( APPEND body "} // namespace\n\nconst std::vector<EmbeddedFile> &embeddedFiles()\n{\n    static const std::vector<EmbeddedFile> list = {\n${table}    };\n    return list;\n}\n\n} // namespace sunstreak\n" )
file( WRITE "${OUT}.tmp" "${body}" )
file( COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT )
file( REMOVE "${OUT}.tmp" )
